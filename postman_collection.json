{
  "info": {
    "name": "Real Estate Management System",
    "description": "Backend-only Spring Boot + JdbcTemplate + H2 REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "Admin Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/admin/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
        }
      }
    },
    {
      "name": "Create Property",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/properties",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Modern 3BHK Flat\",\n  \"description\": \"Near IT park\",\n  \"city\": \"Bhopal\",\n  \"address\": \"Arera Colony, Bhopal\",\n  \"type\": \"APARTMENT\",\n  \"price\": 6500000,\n  \"bedrooms\": 3,\n  \"bathrooms\": 2,\n  \"areaSqft\": 1450,\n  \"status\": \"AVAILABLE\"\n}"
        }
      }
    },
    {
      "name": "Get All Properties",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/properties"
      }
    },
    {
      "name": "Get Property By Id",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/properties/1"
      }
    },
    {
      "name": "Update Property",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/properties/1",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Modern 3BHK Flat (Price Reduced)\",\n  \"description\": \"Near IT park\",\n  \"city\": \"Bhopal\",\n  \"address\": \"Arera Colony, Bhopal\",\n  \"type\": \"APARTMENT\",\n  \"price\": 6200000,\n  \"bedrooms\": 3,\n  \"bathrooms\": 2,\n  \"areaSqft\": 1450,\n  \"status\": \"AVAILABLE\"\n}"
        }
      }
    },
    {
      "name": "Delete Property",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/properties/1"
      }
    },
    {
      "name": "Search Properties",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/properties/search?city=Bhopal&type=APARTMENT&minPrice=3000000&maxPrice=9000000&bedrooms=3&status=AVAILABLE"
      }
    },
    {
      "name": "Create Inquiry",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/inquiries",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"propertyId\": 1,\n  \"name\": \"Priya Verma\",\n  \"email\": \"priya.verma@example.com\",\n  \"phone\": \"9123456780\",\n  \"message\": \"Is this property still available?\"\n}"
        }
      }
    },
    {
      "name": "Get All Inquiries",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/inquiries"
      }
    },
    {
      "name": "Get Inquiries By Property",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/inquiries/property/1"
      }
    },
    {
      "name": "Delete Inquiry",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/inquiries/1"
      }
    }
  ]
}
